#!/usr/bin/env bash
#
# AIOS local CI — runs on every `git push`.
#
# Typechecks + builds (a failure here aborts the push so broken code never
# leaves your machine), then migrates the DB and restarts the local worker +
# web so the running app matches what you're pushing.
#
# Skip in a pinch with:  git push --no-verify
#
exec "$(git rev-parse --show-toplevel)/scripts/deploy-local.sh"
