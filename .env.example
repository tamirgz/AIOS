# AIOS environment — copy to .env.local and adjust.
# AIOS is LOCAL-FIRST: with Docker + Ollama running, every value below has a
# working default and you can leave this file almost empty. Cloud providers are
# optional upgrades.

# ── Database (Postgres in Docker, port 5544) ──────────────────────────────────
# The default matches docker-compose.yml; only change it if you edited compose.
DATABASE_URL=postgres://aios:aios@localhost:5544/aios

# ── Local models (free, no account) ───────────────────────────────────────────
# Ollama on the host. Default works out of the box once `ollama serve` is up.
OLLAMA_BASE_URL=http://localhost:11434

# Apple MLX via LM Studio (OPTIONAL, opt-in — see docs/MODEL-ROUTING.md).
# Only used if you route tasks to the `mlx` provider. Leave as-is if unused.
MLX_BASE_URL=http://localhost:1234/v1

# ── Claude (OPTIONAL upgrade — runs on a Claude Max/Pro subscription, no API key)
# Leave EMPTY to run fully local. To enable: install the `claude` CLI, run
# `claude setup-token`, and paste the token here. (An empty value = not configured.)
CLAUDE_CODE_OAUTH_TOKEN=

# ── Optional integrations / providers ─────────────────────────────────────────
# Web-search enrichment for Ask. Blank disables; a SearXNG endpoint (with JSON
# format enabled) turns it on. Also settable in Settings · Connections.
SEARXNG_URL=

# NVIDIA free-tier cloud provider for Workbench research (optional).
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Gemini base URL (the key itself is entered in Settings, never here).
# GEMINI_BASE_URL=

# ── Paths / misc (sensible defaults; override only if needed) ──────────────────
# Repo path — used by the launchd web entrypoint. Defaults to the repo root.
# AIOS_DIR=
# Nightly pg_dump destination.
# AIOS_BACKUP_DIR=~/Backups/aios
# Public base URL the app reports (Slack in-thread links, etc.).
# APP_BASE_URL=http://localhost:3777
# Local models for the always-local gates/judges (defaults shown).
# INBOX_VERIFY_MODEL=qwen3:8b
# ASK_JUDGE_MODEL=qwen3:8b
