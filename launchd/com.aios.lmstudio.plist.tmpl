<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: rendered by scripts/render-launchd.sh (substitutes {{...}}).
     OPTIONAL — only installed by the MLX opt-in (`aios enable-mlx`). Runs the
     headless LM Studio (llmster) daemon + OpenAI server on :1234 via a
     keepalive wrapper (scripts/lms-keepalive.sh): the script stays alive while
     the server answers and exits when it dies, so KeepAlive=true makes launchd
     restart it — self-healing across crashes/sleep, not just at login. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aios.lmstudio</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>{{AIOS_DIR}}/scripts/lms-keepalive.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{LMS_BIN}}:{{BREW_BIN}}:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>{{AIOS_HOME}}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Don't hot-loop if lms can't start (missing/broken) — wait 30s between tries. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>{{AIOS_HOME}}/Library/Logs/aios-lmstudio.log</string>
  <key>StandardErrorPath</key>
  <string>{{AIOS_HOME}}/Library/Logs/aios-lmstudio.log</string>
</dict>
</plist>
